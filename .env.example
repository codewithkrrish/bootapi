# Copy this to .env and fill in your own values.
# Never commit a real .env — the .gitignore already excludes it.

# Secret used to sign JWTs. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
BOOTAPI_SECRET_KEY=change-me-in-production

# Where the SQLite file lives.
BOOTAPI_DATABASE_PATH=bootapi.db

# How long a login token lasts, in minutes.
BOOTAPI_ACCESS_TOKEN_EXPIRE_MINUTES=30
